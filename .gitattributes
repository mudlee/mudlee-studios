# Normalize all text files to LF on commit
* text=auto eol=lf

# Java source files — always LF
*.java text eol=lf
*.kts  text eol=lf
*.kt   text eol=lf

# Shell scripts — always LF
*.sh   text eol=lf

# Windows batch files — always CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files — no conversion
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
